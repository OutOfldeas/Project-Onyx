<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Führt die Tests der reinen Spiellogik (Onyx.Core) außerhalb von Unity aus,
    z. B. in GitHub Actions. Kompiliert dieselben Quelldateien wie Unity.
    LangVersion 9.0 entspricht dem C#-Stand, den Unity unterstützt.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Onyx.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Onyx/Assets/_Project/Scripts/Core/**/*.cs" />
    <Compile Include="../../Onyx/Assets/_Project/Tests/Core/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
