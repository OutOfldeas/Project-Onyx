# Zeilenenden vereinheitlichen
* text=auto

# Code
*.cs     text diff=csharp
*.shader text
*.hlsl   text
*.md     text

# Unity-YAML (Szenen, Prefabs, Assets) als Text behandeln
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.meta       text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf

# Unity Smart Merge: führt Konflikte in Szenen/Prefabs intelligent zusammen.
# Der Treiber „unityyamlmerge“ wird pro Rechner einmal mit Team-Setup.bat eingerichtet.
*.unity      merge=unityyamlmerge
*.prefab     merge=unityyamlmerge
*.asset      merge=unityyamlmerge
*.mat        merge=unityyamlmerge
*.anim       merge=unityyamlmerge
*.controller merge=unityyamlmerge

# Binärdateien
*.png      binary
*.jpg      binary
*.psd      binary
*.aseprite binary
*.ase      binary
*.wav      binary
*.ogg      binary
*.mp3      binary
*.ttf      binary
*.otf      binary

# Windows-Skripte brauchen CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
